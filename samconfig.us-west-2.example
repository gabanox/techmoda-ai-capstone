# AWS SAM Configuration — TechModa AI Capstone (sandbox AWS re/Start)
#
# Uso:  cp samconfig.us-west-2.example samconfig.toml
#
# samconfig.toml está en .gitignore para no comitear settings específicos de tu cuenta.
# Región fija del sandbox re/Start: us-west-2 (Oregón).

version = 0.1

[default.deploy.parameters]
stack_name = "techmoda-ai"
region = "us-west-2"
# CAPABILITY_AUTO_EXPAND es obligatorio (Transform SAM). NO se necesita crear roles
# nuevos porque las funciones reusan el LabRole (ver docs/SANDBOX-COMPAT.md), pero
# CAPABILITY_IAM se mantiene por compatibilidad del changeset.
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"
confirm_changeset = false
resolve_s3 = true
# El LabRole se toma del default del template; para sobreescribirlo:
# parameter_overrides = "LabRoleArn=arn:aws:iam::<acct>:role/LabRole"
parameter_overrides = []
image_repositories = []

[default.build.parameters]
cached = true
parallel = true
